# Extracted DISA SRG and STIG packages.
#
# These are US Government works whose packages state their own redistribution
# terms, and they are large binary-heavy trees. The repository records their
# identity by digest in artifacts/sources.json and commits the *generated*
# Markdown, never the source package.
#
# Put extracted packages either at the repository root or under sources/.
U_*_SRG/
U_*_STIG/
sources/
*.zip

# The CCI list and the NIST OSCAL files, should they be extracted or saved at
# the root rather than under sources/. The CCI list zip has no directory.
U_CCI_List/
U_CCI_List.*
cci2html.xsl
README.TXT
NIST_SP-800-53_*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
